#!/bin/bash

# gptcp: Format a file's contents with its path and copy to clipboard

# Function to display usage
usage() {
  echo "Usage: gptcp <filename>"
  exit 1
}

# Check if exactly one argument is provided
if [ "$#" -ne 1 ]; then
  usage
fi

FILE_PATH="$1"

# Check if the file exists and is a regular file
if [ ! -f "$FILE_PATH" ]; then
  echo "Error: File '$FILE_PATH' not found."
  exit 1
fi

# Function to find the Git root directory
find_git_root() {
  git rev-parse --show-toplevel 2>/dev/null
}

# Function to calculate relative path
calculate_relative_path() {
  local target="$1"
  local base="$2"

  # Check if GNU realpath is available and supports --relative-to
  if realpath --relative-to="$base" "$target" >/dev/null 2>&1; then
    realpath --relative-to="$base" "$target"
  else
    # Use Perl to calculate relative path
    perl -MFile::Spec -e '
      my ($base, $target) = @ARGV;
      print File::Spec->abs2rel($target, $base);
    ' "$base" "$target"
  fi
}

# Determine the Git root directory
GIT_ROOT=$(find_git_root)

if [ -n "$GIT_ROOT" ]; then
  # Calculate relative path using the function
  REL_PATH=$(calculate_relative_path "$(realpath "$FILE_PATH")" "$(realpath "$GIT_ROOT")")
else
  # If not inside a Git repository, use the absolute path
  REL_PATH=$(realpath "$FILE_PATH")
fi

# Read the file contents
FILE_CONTENTS=$(cat "$FILE_PATH")

# Prepare the formatted text
FORMATTED_TEXT="${REL_PATH}:
\`\`\`
${FILE_CONTENTS}
\`\`\`"

# Function to copy text to clipboard based on OS
copy_to_clipboard() {
  if command -v pbcopy >/dev/null 2>&1; then
    # macOS
    echo "$FORMATTED_TEXT" | pbcopy
  elif command -v xclip >/dev/null 2>&1; then
    # Linux with xclip
    echo "$FORMATTED_TEXT" | xclip -selection clipboard
  elif command -v xsel >/dev/null 2>&1; then
    # Linux with xsel
    echo "$FORMATTED_TEXT" | xsel --clipboard --input
  else
    echo "Error: No clipboard utility found. Please install pbcopy (macOS), xclip, or xsel (Linux)."
    exit 1
  fi
}

# Copy the formatted text to clipboard
copy_to_clipboard

# Confirm to the user
echo "✅ Copied formatted content of '$REL_PATH' to clipboard."

