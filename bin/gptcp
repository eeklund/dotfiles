#!/bin/bash

# gptcp: Format a file's contents with its path and copy to clipboard

# Function to display usage
usage() {
  echo "Usage: gptcp <filename>"
  exit 1
}

# Check if exactly one argument is provided
if [ "$#" -ne 1 ]; then
  usage
fi

FILE_PATH="$1"

# Check if the file exists and is a regular file
if [ ! -f "$FILE_PATH" ]; then
  echo "Error: File '$FILE_PATH' not found."
  exit 1
fi

# Function to find the Git root directory for the given file/dir
find_git_root_for() {
  local path="$1"
  # Use the file's directory as the base for git -C
  git -C "$(dirname "$path")" rev-parse --show-toplevel 2>/dev/null
}

# Function to calculate relative path
calculate_relative_path() {
  local target="$1"
  local base="$2"

  # Check if GNU realpath is available and supports --relative-to
  if realpath --relative-to="$base" "$target" >/dev/null 2>&1; then
    realpath --relative-to="$base" "$target"
  else
    # Use Perl to calculate relative path
    perl -MFile::Spec -e '
      my ($base, $target) = @ARGV;
      print File::Spec->abs2rel($target, $base);
    ' "$base" "$target"
  fi
}

# Determine the Git root directory (using absolute file path)
ABS_PATH="$(realpath "$FILE_PATH")"
GIT_ROOT="$(find_git_root_for "$ABS_PATH")"

if [ -n "$GIT_ROOT" ]; then
  REL_PATH=$(calculate_relative_path "$ABS_PATH" "$(realpath "$GIT_ROOT")")
else
  REL_PATH="$ABS_PATH"
fi

# Stream markers + file to the clipboard (preserves content exactly)
copy_to_clipboard() {
  if command -v pbcopy >/dev/null 2>&1; then
    {
      printf '<<<BEGIN file="%s">>>\n' "$REL_PATH"
      cat -- "$FILE_PATH"
      printf '\n<<<END file="%s">>>\n\n' "$REL_PATH"
    } | pbcopy
  elif command -v xclip >/dev/null 2>&1; then
    {
      printf '<<<BEGIN file="%s">>>\n' "$REL_PATH"
      cat -- "$FILE_PATH"
      printf '\n<<<END file="%s">>>\n\n' "$REL_PATH"
    } | xclip -selection clipboard
  elif command -v xsel >/dev/null 2>&1; then
    {
      printf '<<<BEGIN file="%s">>>\n' "$REL_PATH"
      cat -- "$FILE_PATH"
      printf '\n<<<END file="%s">>>\n\n' "$REL_PATH"
    } | xsel --clipboard --input
  else
    echo "Error: No clipboard utility found. Please install pbcopy (macOS), xclip, or xsel (Linux)."
    exit 1
  fi
}

# Copy the formatted text to clipboard
copy_to_clipboard

# Confirm to the user
echo "✅ Copied formatted content of '$REL_PATH' to clipboard."

