#!/bin/bash

# Define sessions
sessions=("dev" "test" "server")

# SSH details
SERVER="eeklund@asr-eeklund-dev-devops-01.oit.umn.edu"

open_tmux_sessions() {
  for session in "${sessions[@]}"; do
    osascript <<EOF
    tell application "iTerm2"
      if (count of windows) is 0 then
        create window with default profile
      else
        tell current window
          create tab with default profile
        end tell
      end if
      tell current session of current tab of current window
        write text "ssh $SERVER -t 'tmux attach-session -t $session'"
      end tell
    end tell
EOF
  done
}

open_tmux_sessions
