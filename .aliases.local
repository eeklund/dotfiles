# Docker
alias dce='docker-compose exec'
alias dcer='docker-compose exec -e RAILS_TEMPLATE_DIR=~/code/rails_templates/ web bin/rails'
alias dcert='docker-compose exec -e RAILS_ENV=test web bin/rails'
alias railworks='docker run --rm -it -v ${PWD}:/app railworks'

# Git helpers
alias coauthor='cat ~/.git_coauthor_commit_template | pbcopy'
alias gb='git checkout -b'
alias gx='g branch --merged | grep -v master | grep -v main | xargs git branch -d'

