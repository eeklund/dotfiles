# Helpers
alias github_api='echo "a1de557c0be413053331d7a08c94ea42198eac5e" | pbcopy'
alias kb='cd ~/code/knowledgebucket && git co main && git pull origin main && code . && cd -'
alias professional_development='code ~/Documents/notes/professional_development.md'
alias check_uofm_vpn='output=$(/opt/cisco/anyconnect/bin/vpn stats) && echo "$output" | grep -q "Connected to tc-vpn-1.vpn.umn.edu" && test $(echo "$output" | grep -q "Tunnel mode (IPv4)" | awk -F"Split |$" "{print $2}") == "Exclude" && echo true || echo false'
alias vnc_oldlaptop='open vnc://C02XM2T7JGH6.local'
